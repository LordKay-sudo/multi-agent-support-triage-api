APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=local
LLM_PROVIDER=mock

# Set to true after configuring Langfuse keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Required only when LLM_PROVIDER=bedrock.
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
